# =============================================================================
# VeriTrace — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.
# In production, all secrets are injected via Google Cloud Secret Manager.
# =============================================================================

# --- Gemini API ---
# Get from: https://aistudio.google.com/app/apikey
# Server-only — NEVER prefix with NEXT_PUBLIC_
GEMINI_API_KEY=

# --- Firebase Client Config (PUBLIC — safe to expose) ---
# Get from: Firebase Console → Project Settings → Your apps → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (SERVER-ONLY — never prefix with NEXT_PUBLIC_) ---
# Get from: Firebase Console → Project Settings → Service accounts → Generate new private key
# In production: loaded automatically from Cloud Secret Manager via App Hosting
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the private key exactly as-is (including -----BEGIN/END----- lines)
# Wrap in double quotes in .env.local to handle newlines
FIREBASE_ADMIN_PRIVATE_KEY=
