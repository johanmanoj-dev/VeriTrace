rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Reports: authenticated owner can read; all writes are server-only via Admin SDK
    match /reports/{reportId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow write: if false;
    }

    // Cache: authenticated users can read (shared dedup cache)
    // Write is backend-only via Admin SDK — client writes are denied
    match /cache/{hash} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
