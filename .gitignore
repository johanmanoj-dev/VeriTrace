# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# service account secrets & keys
*adminsdk*.json
*service-account*.json
*.key

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env — keep example, ignore everything else
!.env.example

# playwright
/playwright-report/
/test-results/

# firebase
firebase-debug.log
.firebase/
